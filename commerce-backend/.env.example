# Copy to .env for local development only. Production values belong in the host secret manager.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
COOKIE_SECRET=
COMMERCE_BRIDGE_SECRET=
# Exact deployed origins; comma-separated if more than one is needed.
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=
MEDUSA_WORKER_MODE=shared
MEDUSA_DISABLE_TELEMETRY=true
# Explicit development/test fixture switch. Never enable in production.
ALLOW_SAMPLE_SEED=false
# Optional development-only Admin HMR port.
HMR_PORT=9001
