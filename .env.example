# Standalone GitHub application only. Use the actual deployed HTTPS origin, with no trailing slash.
CUSTOMER_APP_ORIGIN=
# Verified Resend sender required for password reset delivery. Store API key as a runtime secret.
RESEND_API_KEY=
CUSTOMER_EMAIL_FROM=

# Commerce integration. Keep preview until the services and real business settings are ready.
COMMERCE_MODE=preview
MEDUSA_BACKEND_URL=
MEDUSA_PUBLISHABLE_KEY=
# Same random secret as the commerce backend. Server-only; never use a VITE_/NEXT_PUBLIC_ prefix.
COMMERCE_BRIDGE_SECRET=
